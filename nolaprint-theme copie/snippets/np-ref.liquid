{% doc %}
  Référentiel NolaPrint de Noël 2026 (décisions 13, 14, 15 ; brief de génération, section 2) :
  destinataires, titres, palettes, symboles, gabarits et limites de texte.
  Une seule source pour la fiche produit (JSON lu par np.js) et pour les libellés Liquid.

  @param {string} mode - 'json' (tout le référentiel), 'dest' (nom d'un destinataire), 'gab' (nom d'un gabarit)
  @param {string} [id] - id du destinataire (mode 'dest')
  @param {string} [gabarit] - 'A', 'B' ou 'blanche' (mode 'gab')
  @param {string} [declinaison] - 'base' ou 'noel' (mode 'gab')
{% enddoc %}
{%- case mode -%}
  {%- when 'dest' -%}
    {%- case id -%}
      {%- when 'maman' -%}Maman
      {%- when 'papa' -%}Papa
      {%- when 'mamie' -%}Mamie
      {%- when 'papy' -%}Papy
      {%- when 'couple' -%}Couple
      {%- when 'famille' -%}Famille
    {%- endcase -%}
  {%- when 'gab' -%}
    {%- if gabarit == 'A' -%}{%- if declinaison == 'noel' -%}Le sapin{%- else -%}Le jardin{%- endif -%}
    {%- elsif gabarit == 'B' -%}{%- if declinaison == 'noel' -%}Le goûter d’hiver chez{%- else -%}Le goûter chez{%- endif -%}
    {%- else -%}Votre image{%- endif -%}
  {%- when 'json' -%}
