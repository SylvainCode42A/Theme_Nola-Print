{% doc %}
  Silhouette d'une forme de décoration en bois, d'après le nom de l'option.

  @param {string} shape - nom de la forme (Cœur, Sapin, Étoile, Cloche, Chaussette de Noël, Ovale)
{% enddoc %}
{%- liquid
  assign s = shape | downcase
-%}
<svg class="np-shape" width="30" height="30" viewBox="0 0 40 40" aria-hidden="true">
  {%- if s contains 'cœur' or s contains 'coeur' or s contains 'heart' -%}
    <path d="M20 34C14 29 5 23 5 14.5 5 9.5 9 6 13.5 6c3 0 5.2 1.7 6.5 4 1.3-2.3 3.5-4 6.5-4C31 6 35 9.5 35 14.5 35 23 26 29 20 34z" fill="currentColor"/>
  {%- elsif s contains 'sapin' or s contains 'tree' -%}
    <path d="M20 3l7 10h-3l7 9h-4l7 9H6l7-9H9l7-9h-3z" fill="currentColor"/><rect x="17.5" y="31" width="5" height="6" rx="1" fill="currentColor"/>
  {%- elsif s contains 'étoile' or s contains 'etoile' or s contains 'star' -%}
    <path d="M20 4l4.8 10 11 1.4-8.1 7.6 2.1 10.9L20 28.6 10.2 33.9l2.1-10.9L4.2 15.4l11-1.4z" fill="currentColor"/>
  {%- elsif s contains 'cloche' or s contains 'bell' -%}
    <path d="M20 5c-6 0-10 4.5-10 11v8l-3 5h26l-3-5v-8c0-6.5-4-11-10-11z" fill="currentColor"/><circle cx="20" cy="33" r="3" fill="currentColor"/>
  {%- elsif s contains 'chaussette' or s contains 'stocking' -%}
    <path d="M13 4h13v17c0 4-2 7-6 9.5l-5 3c-3 1.8-7-.4-7-4 0-2 1-3.4 2.7-4.4L13 23V4z" fill="currentColor"/><rect x="12" y="4" width="15" height="6" rx="1.5" fill="currentColor" opacity=".55"/>
  {%- else -%}
    <ellipse cx="20" cy="20" rx="12" ry="16" fill="currentColor"/>
  {%- endif -%}
</svg>
