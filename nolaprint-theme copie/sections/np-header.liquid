{%- comment -%}
  En-tête NolaPrint : bande d'annonce, logo, menu, panier.
  Menu : Mugs, Boules de Noël et Décorations en bois ouvrent directement la fiche produit de l'objet (le mug en 3D),
  celle du gabarit A (nouveau produit s'il est en ligne, sinon l'ancien : snippet np-handle) ; à défaut, lien direct
  vers l'ancienne fiche (/products/mug-personnalise…), comme l'ancien thème. Noël mène à la collection noel (tag noel), sinon à la galerie filtrée.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign root = routes.root_url
  # Les boutons du menu ouvrent directement les fiches produit (mug en 3D), comme l'ancien thème
  assign mug_url = '/products/mug-personnalise'
  assign verre_url = '/products/boule-de-noel-verre-personnalisee'
  assign bois_url = '/products/decoration-bois-personnalisee'
  assign noel_url = root | append: '?pour=noel#designs'
  if collections['noel'].id
    assign noel_url = collections['noel'].url
  endif
  capture hb
    render 'np-handle', objet: 'mug', gabarit: 'blanche'
  endcapture
  assign hb = hb | strip
  assign blanche_url = routes.root_url | append: '#votre-photo'
  # « Votre photo » : toujours la page photo du mug
-%}
<div class="announce" role="region" aria-label="Annonces">
  <div class="marquee"><div class="marquee-track" id="annTrack">
    {%- for i in (1..6) -%}
      {%- assign key = 'ann_' | append: i -%}
      {%- if s[key] != blank -%}<span>{{ s[key] }}</span>{%- endif -%}
    {%- endfor -%}
  </div></div>
</div>

<header class="site">
  <div class="wrap">
    <a class="logo" href="{{ routes.root_url }}" aria-label="NolaPrint, accueil">
      <svg width="34" height="34" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22.5" fill="#FFFFFF" stroke="#C1121F" stroke-width="2.5"/><g fill="none" stroke="#7A4A22" stroke-width="2.2" stroke-linecap="round"><path d="M14 19C10.5 15 9.5 11.5 10.5 8"/><path d="M11.5 13L7.5 11.5"/><path d="M34 19C37.5 15 38.5 11.5 37.5 8"/><path d="M36.5 13L40.5 11.5"/></g><ellipse cx="13.5" cy="24" rx="3.6" ry="2" transform="rotate(-25 13.5 24)" fill="#A86B3C"/><ellipse cx="34.5" cy="24" rx="3.6" ry="2" transform="rotate(25 34.5 24)" fill="#A86B3C"/><ellipse cx="24" cy="28" rx="9.5" ry="10.5" fill="#A86B3C"/><ellipse cx="24" cy="33.5" rx="7" ry="5.3" fill="#EBCFA6"/><path d="M18.3 25.6q2-2.6 4 0M25.7 25.6q2-2.6 4 0" fill="none" stroke="#2A1B1D" stroke-width="1.6" stroke-linecap="round"/><circle cx="17" cy="29" r="1.5" fill="#F29AA0" opacity=".8"/><circle cx="31" cy="29" r="1.5" fill="#F29AA0" opacity=".8"/><circle cx="24" cy="30.2" r="2.8" fill="#C1121F"/><path d="M20.2 34.2q3.8 5.6 7.6 0z" fill="#5A1620"/><ellipse cx="24" cy="36.8" rx="2" ry="1.1" fill="#F07A86"/><path d="M14.5 20.5Q20 7 35.5 7.5L31.5 18.8Z" fill="#C1121F"/><path d="M14 20.6L32 18.6" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/><circle cx="36" cy="7.8" r="3" fill="#FFFFFF"/></svg>
      <b>NolaPrint</b>
    </a>
    <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="mainNav" aria-label="Ouvrir le menu">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <nav class="main" id="mainNav" aria-label="Navigation principale">
      <a href="{{ mug_url }}">Mugs</a>
      <a href="{{ verre_url }}">Boules de Noël</a>
      <a href="{{ bois_url }}">Décorations en bois</a>
      <a href="{{ blanche_url }}">Votre photo</a>
      <a href="{{ routes.root_url }}#questions">Questions</a>
    </nav>
    <a class="cart-btn" id="cartBtn" href="{{ routes.cart_url }}" aria-label="Panier, {{ cart.item_count }} article{% if cart.item_count > 1 %}s{% endif %}">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7zM9 7a3 3 0 016 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <span class="cart-count" id="cartCount">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "En-tête NolaPrint",
  "settings": [
    { "type": "header", "content": "Bande d'annonce (défile en boucle)" },
    { "type": "inline_richtext", "id": "ann_1", "label": "Message 1", "default": "<b>Une fleur de naissance</b> pour chaque prénom" },
    { "type": "inline_richtext", "id": "ann_2", "label": "Message 2", "default": "Ou partez <b>de votre photo</b>" },
    { "type": "inline_richtext", "id": "ann_3", "label": "Message 3", "default": "Lot de 3 : jusqu'à −10 % sur le même objet" },
    { "type": "inline_richtext", "id": "ann_4", "label": "Message 4", "default": "Fabriqué à la commande en Europe" },
    { "type": "inline_richtext", "id": "ann_5", "label": "Message 5", "default": "Article abîmé ? Refait gratuitement" },
    { "type": "inline_richtext", "id": "ann_6", "label": "Message 6", "default": "Livraison offerte dès 60 €" }
  ]
}
{% endschema %}
