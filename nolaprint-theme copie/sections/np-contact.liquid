<div class="page np-legal">
  <nav class="crumbs" aria-label="Fil d'Ariane"><a href="{{ routes.root_url }}">Accueil</a> / <span aria-current="page">{{ page.title | escape }}</span></nav>
  <h1>{{ page.title | escape }}</h1>
  {%- if section.settings.intro != blank -%}<p class="muted">{{ section.settings.intro | escape }}</p>{%- endif -%}
  {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
  {%- form 'contact', class: 'form-card', id: 'np-contact-form' -%}
    {%- if form.posted_successfully? -%}
      <p class="ack" role="status">Merci, votre message est bien envoyé. Nous vous répondons sous 48 heures ouvrées.</p>
    {%- elsif form.errors -%}
      <div class="box legal" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="grid-2">
      <div class="field"><label for="ctName">Nom</label><input class="input" id="ctName" name="contact[name]" required autocomplete="name" value="{{ form.name }}"></div>
      <div class="field"><label for="ctMail">E-mail</label><input class="input" id="ctMail" type="email" name="contact[email]" required autocomplete="email" value="{{ form.email }}"></div>
    </div>
    <div class="field"><label for="ctOrder">Numéro de commande (facultatif)</label><input class="input" id="ctOrder" name="contact[Numéro de commande]"></div>
    <div class="field"><label for="ctMsg">Message</label><textarea class="input" id="ctMsg" name="contact[body]" rows="5" required>{{ form.body }}</textarea></div>
    <button class="btn btn-primary" type="submit">Envoyer</button>
  {%- endform -%}
  {%- if section.settings.footer != blank -%}<p class="muted" style="margin-top:1rem">{{ section.settings.footer }}</p>{%- endif -%}
</div>
{%- render 'np-breadcrumbs-ld', name: page.title, url: page.url -%}

{% schema %}
{
  "name": "Formulaire de contact",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "intro", "label": "Introduction", "default": "Réponse sous 48 heures ouvrées. Pour un article abîmé, indiquez votre numéro de commande : nous vous demanderons une photo de l'article et du colis par retour d'e-mail." },
    { "type": "html", "id": "footer", "label": "Coordonnées (HTML)", "default": "E-mail : <a href=\"mailto:contact@nolaprint.fr\">contact@nolaprint.fr</a> · réponse sous 48 heures ouvrées" }
  ],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
