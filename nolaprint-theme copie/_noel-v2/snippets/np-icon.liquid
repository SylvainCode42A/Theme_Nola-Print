{% doc %}
  Icônes au trait NolaPrint : contour de la couleur du texte (rouge dans les cases), intérieur blanc.

  @param {string} name - 'box' | 'truck' | 'tree' | 'gift'
  @param {number} [size] - taille en pixels (28 par défaut)
{% enddoc %}
{%- assign sz = size | default: 28 -%}
<svg class="np-icon" width="{{ sz }}" height="{{ sz }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'box' -%}
      <path d="M12 2.8l8.2 4.1v10.2L12 21.2l-8.2-4.1V6.9L12 2.8z" fill="#FFFFFF"/><path d="M3.8 6.9L12 11l8.2-4.1M12 11v10.2M7.9 4.85l8.2 4.1v3.4"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9.5h-11z" fill="#FFFFFF"/><path d="M13.5 9.5h4.2l3.3 3.4V16h-7.5z" fill="#FFFFFF"/><circle cx="6.8" cy="17.3" r="1.9" fill="#FFFFFF"/><circle cx="17.2" cy="17.3" r="1.9" fill="#FFFFFF"/>
    {%- when 'tree' -%}
      <path d="M12 2.5l4.2 5.6h-2.3l3.8 5h-2.4l4.2 5.4H4.5l4.2-5.4H6.3l3.8-5H7.8L12 2.5z" fill="#FFFFFF"/><path d="M12 18.5v3"/>
    {%- when 'gift' -%}
      <path d="M4 11h16v9.5H4z" fill="#FFFFFF"/><path d="M3 7.5h18V11H3z" fill="#FFFFFF"/><path d="M12 7.5v13"/><path d="M12 7.5c-1.4-2.9-4.9-3.4-4.9-1.5S10.3 7.5 12 7.5zm0 0c1.4-2.9 4.9-3.4 4.9-1.5S13.7 7.5 12 7.5z" fill="#FFFFFF"/>
  {%- endcase -%}
</svg>
