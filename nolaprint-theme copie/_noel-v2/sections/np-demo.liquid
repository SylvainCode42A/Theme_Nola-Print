{%- comment -%}
  Démo de l'accueil : choisissez pour qui, tapez un prénom ; l'aperçu est rendu par le serveur (réglage np_apercu_url),
  avec le même code que le fichier d'impression. Sans serveur : images d'exemple par destinataire.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  capture h
    render 'np-handle', objet: 'mug', gabarit: 'A'
  endcapture
  assign h = h | strip
  assign mug_url = '/products/' | append: h
  if all_products[h].id
    assign mug_url = all_products[h].url
  endif
  assign demo_dests = 'mamie,papy,maman,papa' | split: ','
  assign api = settings.np_apercu_url | strip
-%}
<section class="block" id="essai"><div class="wrap">
  <div class="demo-box np-demo" data-np-demo>
    <div class="np-demo-stage">
      <div class="np-stage" data-type="mug">
        <img class="np-base" src="{{ 'np2-ex-mug-a-mamie-base.jpg' | asset_url }}" alt="Aperçu du mug personnalisé" width="1000" height="1000" loading="lazy" data-np-base>
        <span class="np-apercu-etat" data-np-demo-etat hidden></span>
      </div>
    </div>
    <div class="demo-form">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2>{% if api != blank %}{{ s.heading | escape }}{% else %}{{ s.heading_static | escape }}{% endif %}</h2>
      <div class="field"><span class="np-label">Pour qui ?</span>
        <div class="np-demo-sw" role="group" aria-label="Choisir le destinataire">
          {%- for d in demo_dests -%}
            {%- capture ex -%}np2-ex-mug-a-{{ d }}-base.jpg{%- endcapture -%}
            <button type="button" class="chip" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-np-demo-dest="{{ d }}" data-img="{{ ex | asset_url }}">{%- render 'np-ref', mode: 'dest', id: d -%}</button>
          {%- endfor -%}
        </div></div>
      {%- if api != blank -%}
        <div class="field"><label for="demoName">Un prénom</label><input class="input" id="demoName" maxlength="15" placeholder="Ex. Léa" autocomplete="off" data-np-demo-input></div>
      {%- else -%}
        <input type="hidden" data-np-demo-input>
        <p class="np-demo-note">{{ s.text_static | escape }}</p>
      {%- endif -%}
      <script type="application/json" data-np-demo-data>{ "apercu": {{ api | json }}, "dest": "mamie",
        "titres": { "mamie": "Mamie", "papy": "Papy", "maman": "Maman", "papa": "Papa" },
        "couleurs": { "mamie": "#6B4430", "papy": "#2B3A67", "maman": "#7B3F61", "papa": "#2B3A67" } }</script>
      {%- if s.cta_label != blank -%}<a class="btn btn-white" href="{{ mug_url }}?pour=mamie" data-np-demo-cta data-base="{{ mug_url }}">{{ s.cta_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</div></section>

{% schema %}
{
  "name": "Démo de personnalisation",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Faites l'essai" },
    { "type": "text", "id": "heading", "label": "Titre H2 (avec serveur d'aperçu)", "default": "Tapez un prénom, il apparaît sur le mug" },
    { "type": "text", "id": "heading_static", "label": "Titre H2 (sans serveur d'aperçu)", "default": "Le même mug, pour chacun" },
    { "type": "text", "id": "text_static", "label": "Texte (sans serveur d'aperçu)", "default": "Le titre et les couleurs changent selon la personne : choisissez, puis ajoutez les prénoms sur la fiche." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Personnaliser ce mug" }
  ],
  "presets": [{ "name": "Démo de personnalisation" }]
}
{% endschema %}
